<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.viacosta.controller.HistorialVentasController">
   <children>
      <!-- MÉTRICAS DE VENTAS -->
      <HBox spacing="16.0">
         <children>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="OPERACIONES REGISTRADAS" styleClass="metric-label" />
                  <Label fx:id="lblTotalVentas" text="0" styleClass="metric-value" />
               </children>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="RECAUDACIÓN TOTAL" styleClass="metric-label" />
                  <Label fx:id="lblMontoRecaudado" text="S/ 0.00" styleClass="metric-value" style="-fx-text-fill: #10b981;" />
               </children>
            </VBox>
            <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button onAction="#onActualizar" styleClass="btn, btn-secondary" text="🔄 Refrescar BD" />
                        <Button onAction="#onReimprimir" styleClass="btn, btn-primary" text="🖨️  Reimprimir Comprobante" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- TABLA 1: COMPRAS / CABECERAS -->
      <VBox spacing="12.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="card-title" text="Cabeceras de Venta y Comprobantes Fiscales" />
                  <Label styleClass="card-subtitle" text="Seleccione una operación para auditar los asientos y pasajes emitidos" />
               </children>
            </VBox>

            <TableView fx:id="tblCompras" prefHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colComprobante" prefWidth="130.0" text="Comprobante" />
                  <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha / Hora" />
                  <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente / Pasajero" />
                  <TableColumn fx:id="colEmpleado" prefWidth="130.0" text="Vendedor" />
                  <TableColumn fx:id="colMetodo" prefWidth="100.0" text="Método Pago" />
                  <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <!-- TABLA 2: DETALLES DE BOLETO ASOCIADOS -->
      <VBox spacing="12.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="card-title" text="Detalle de Boletos / Asientos por Operación" />
                  <Label fx:id="lblDetalleCompraTitulo" styleClass="card-subtitle" text="Seleccione una compra en la tabla superior" style="-fx-text-fill: #38bdf8;" />
               </children>
            </VBox>

            <TableView fx:id="tblDetalles" prefHeight="160.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDetAsiento" prefWidth="100.0" text="N° Asiento" />
                  <TableColumn fx:id="colDetTipo" prefWidth="110.0" text="Tipo de Asiento" />
                  <TableColumn fx:id="colDetRuta" prefWidth="160.0" text="Ruta del Viaje" />
                  <TableColumn fx:id="colDetFechaHora" prefWidth="140.0" text="Salida Programada" />
                  <TableColumn fx:id="colDetPrecio" prefWidth="100.0" text="Importe Asiento" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
